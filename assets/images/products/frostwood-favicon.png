<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Page not found — Frostwood CRM</title>
    <link rel="icon" href="https://frostwoodcrm.com/images/favicon.png">
    <style>
        :root {
            --brand: #155DFC;
            --brand-ink: #0b3aa8;
            --ink: #101828;
            --muted: #667085;
            --border: #E4E7EC;
            --bg: #F7F9FC;
            --card: #FFFFFF;
        }

        * { box-sizing: border-box; }

        html, body { height: 100%; }

        body {
            margin: 0;
            font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--ink);
            background:
                radial-gradient(1100px 520px at 50% -10%, rgba(21, 93, 252, .10), transparent 70%),
                var(--bg);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        .card {
            position: relative;
            width: 100%;
            max-width: 540px;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 44px 40px 40px;
            box-shadow: 0 24px 60px -24px rgba(16, 24, 40, .18);
            overflow: hidden;
            text-align: center;
        }

        .brand {
            display: inline-block;
            margin-bottom: 26px;
        }

        .brand img {
            height: 34px;
            width: auto;
            display: block;
        }

        .code {
            font-size: 92px;
            font-weight: 800;
            letter-spacing: -0.04em;
            line-height: 1;
            background: linear-gradient(180deg, var(--brand), var(--brand-ink));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin: 4px 0 10px;
        }

        h1 {
            font-size: 21px;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin: 0 0 8px;
        }

        p.msg {
            margin: 0 auto 28px;
            max-width: 40ch;
            color: var(--muted);
            font-size: 14.5px;
        }

        .actions {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            appearance: none;
            border: 1px solid transparent;
            border-radius: 10px;
            padding: 11px 20px;
            font-size: 14px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            text-decoration: none;
            transition: background-color .15s ease, border-color .15s ease, color .15s ease;
        }

        .btn-primary {
            background: var(--brand);
            color: #fff;
        }

        .btn-primary:hover { background: var(--brand-ink); }

        .btn-ghost {
            background: #fff;
            border-color: var(--border);
            color: var(--ink);
        }

        .btn-ghost:hover { background: var(--bg); }

        .ref {
            margin-top: 26px;
            font-size: 12px;
            color: var(--muted);
        }

        @media (max-width: 480px) {
            .card { padding: 36px 24px 32px; border-radius: 16px; }
            .code { font-size: 72px; }
        }
    </style>
</head>
<body>
    <main class="card">
        <a class="brand" href="/">
            <img src="https://frostwoodcrm.com/images/FrostwoodCRM-01.png" alt="Frostwood CRM">
        </a>

        <div class="code">404</div>

        <h1>Page not found</h1>

        <p class="msg">Oops! The page you&#039;re looking for is on vacation. It seems we couldn&#039;t find what you were searching for.</p>

        <div class="actions">
            <a class="btn btn-primary" href="/">Back to homepage</a>
            <a class="btn btn-ghost" href="/" onclick="if (window.history.length > 1) { event.preventDefault(); window.history.back(); }">Go back</a>
        </div>

        <p class="ref">Error 404</p>
    </main>
</body>
</html>
