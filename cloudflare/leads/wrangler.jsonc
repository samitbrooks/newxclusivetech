  "d1_databases": [{"binding": "LEADS_DB", "database_name": "xclusivetech-leads", "database_id": "8455634a-4299-4c1c-89b2-564d3fa73103", "migrations_dir": "migrations"}],
  "send_email": [{"name": "EMAIL", "allowed_sender_addresses": ["hello@xclusivetech.co.ke"]}],
